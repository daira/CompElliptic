  have hc_3 : x19_6 + lo_x14_10 = 2^64 * c_48 := by
    have h := cancel_low x19_6 inv modulus.l0 hinv
    rw [← e_x5, ← e_x4, ← e_x3_3, ← d_x14_10, Nat.add_mul_mod_self_left,
