  have hkr_3 : k_x23_13 = 0 := by
    clear * - hsum'_3 F_3 B_2 hs_3 b_x15_13 bc_3 hsh_3
    omega
  have hks_3 : k_x23_14 = 0 := by clear * - l_x23_14 b_c_55; omega
  have I_3 : 2^64 * (x19_7 + 2^64 * x20_15 + 2^128 * x21_15 + 2^192 * x22_15 + 2^256 * x23_14)
