    rw [e_x14_11, e_c_56]; exact subc_lin x19_7 x5 1 b_x5 (by decide)
  have b_x14_11 : x14_11 < 2^64 := by rw [e_x14_11]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
