  subst out0 out1 out2 out3
  have hLR : lhs.toNat * rhs.toNat
      = lhs.toNat * x9 + 2^64 * (lhs.toNat * x9_1) + 2^128 * (lhs.toNat * x9_2)
        + 2^192 * (lhs.toNat * x9_3) := by
    rw [e_x9, e_x9_1, e_x9_2, e_x9_3]; simp only [Limbs.toNat]; ring
