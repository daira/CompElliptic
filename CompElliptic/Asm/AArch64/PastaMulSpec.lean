  have b_x10_1 : x10_1 < 2^64 := by rw [e_x10_1]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  have b_c_4 : c_4 ≤ 1 := by
    rw [e_c_4]; exact addc_carry_le_one x11_1 x14 0 b_x11_1 b_x14 (by decide)
